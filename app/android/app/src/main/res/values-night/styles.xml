<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- IHTD currently has a light Flutter theme even when the OS is dark.
         Use the same window surfaces and icon contrast during startup. -->
    <style name="LaunchTheme" parent="IhtdWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ihtd_header</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ihtd_splash</item>
    </style>
    <style name="NormalTheme" parent="IhtdWindowTheme" />
</resources>
